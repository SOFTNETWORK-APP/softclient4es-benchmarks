# Local environment and secrets
.env

# Virtualenvs
.venv*/
__pycache__/
*.pyc

# Measured run output. Sessions that back a published number are committed
# deliberately with `git add -f <path>/results/<session>/`; everything else here
# is scratch.
**/results/*/
**/results/*.log
# Driver transcripts only. NOT `*.json`: the loose files at results/ root include the
# engine-quiescence gate records that RESULTS cites as provenance, and a blanket rule
# there silently excluded the evidence for a published session.
**/results/driver-*.out
**/results/phase*-*.out
**/results/summary.md

# Local-only Docker override (e.g. licence injection for full-scale runs)
extraction-vs-trino/docker-compose.override.yml
